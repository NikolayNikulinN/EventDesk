<Window x:Class="EventDesk.App.Views.Dialogs.CalendarEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:calendar="clr-namespace:EventDesk.Resources.Controls.Calendar;assembly=EventDesk.Resources"
        Style="{StaticResource CalendarEditorDialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle"
        Title="{Binding EditorHeading}">
  <Grid x:Name="DialogBackdrop">
    <Grid.InputBindings>
      <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
    </Grid.InputBindings>
    <Button Style="{StaticResource CalendarEditorBackdropButtonStyle}"
            IsTabStop="False"
            Command="{Binding CancelEditCommand}"
            AutomationProperties.Name="{Binding Resources.Cancel}" />
    <calendar:CalendarEditorControl HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="{StaticResource CalendarPagePadding}" />
  </Grid>
</Window>
