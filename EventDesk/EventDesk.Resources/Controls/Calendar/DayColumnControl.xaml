<UserControl x:Class="EventDesk.Resources.Controls.Calendar.DayColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calendar="clr-namespace:EventDesk.Resources.Controls.Calendar"
             Width="{Binding DayWidth, RelativeSource={RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}}">
  <Border BorderBrush="{StaticResource CalendarGridLineBrush}" BorderThickness="1,0,0,0">
    <Grid Height="{Binding TimelineHeight, RelativeSource={RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}}">
      <ItemsControl ItemsSource="{Binding DataContext.HourLabels, RelativeSource={RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Height="{Binding HourHeight, RelativeSource={RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}}" BorderBrush="{StaticResource CalendarGridLineBrush}" BorderThickness="0,0,0,1" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Events}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Top">
              <Setter.Value>
                <MultiBinding Converter="{StaticResource CalendarHourScaleConverter}">
                  <Binding Path="Top" />
                  <Binding Path="HourHeight" RelativeSource="{RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
            <Setter Property="Canvas.Left">
              <Setter.Value>
                <MultiBinding Converter="{StaticResource CalendarDayScaleConverter}">
                  <Binding Path="Left" />
                  <Binding Path="DayWidth" RelativeSource="{RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <calendar:EventCardControl />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
