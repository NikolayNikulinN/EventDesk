<UserControl x:Class="EventDesk.Resources.Controls.Calendar.CalendarEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             IsVisibleChanged="EditorVisibilityChanged"
             Width="360">
  <Border Style="{StaticResource CalendarEditorPanelStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Margin="{StaticResource CalendarEditorHeadingMargin}">
        <Button DockPanel.Dock="Right"
                Style="{StaticResource CalendarEditorCancelButtonStyle}"
                Command="{Binding CancelEditCommand}"
                ToolTip="{Binding Resources.Cancel}"
                AutomationProperties.Name="{Binding Resources.Cancel}">
          <Image Style="{StaticResource CalendarEditorCancelIconStyle}"
                 Source="{Binding Resources.CancelIconPath}" />
        </Button>
        <TextBlock Style="{StaticResource CalendarEditorHeadingStyle}"
                   Text="{Binding EditorHeading}" />
      </DockPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource CalendarFieldLabelStyle}" Text="{Binding Resources.EventTitle}" />
          <TextBox x:Name="EventTitleTextBox"
                   Style="{StaticResource CalendarEditorTextBoxStyle}"
                   MaxLength="500"
                   Text="{Binding EventTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Style="{StaticResource CalendarFieldLabelStyle}" Text="{Binding Resources.EventDescription}" />
          <TextBox Style="{StaticResource CalendarEditorDescriptionTextBoxStyle}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   MaxLength="2000"
                   Text="{Binding EventDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Style="{StaticResource CalendarFieldLabelStyle}" Text="{Binding Resources.StartDate}" />
          <ui:CalendarDatePicker Style="{StaticResource CalendarEditorDatePickerStyle}"
                                 Date="{Binding StartDate, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding Resources.StartDate}"
                                 Content="{Binding StartDate, StringFormat={}{0:d}}" />

          <TextBlock Style="{StaticResource CalendarFieldLabelStyle}" Text="{Binding Resources.StartTime}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="58" />
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0"
                    Style="{StaticResource CalendarEditorTimeSliderStyle}"
                    Value="{Binding StartMinuteOfDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{Binding Resources.StartTime}"
                    ToolTip="{Binding StartTime}" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource CalendarEditorTimeValueStyle}"
                       Text="{Binding StartTime}" />
          </Grid>

          <TextBlock Style="{StaticResource CalendarFieldLabelStyle}" Text="{Binding Resources.EndDate}" />
          <ui:CalendarDatePicker Style="{StaticResource CalendarEditorDatePickerStyle}"
                                 Date="{Binding EndDate, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding Resources.EndDate}"
                                 Content="{Binding EndDate, StringFormat={}{0:d}}" />

          <TextBlock Style="{StaticResource CalendarFieldLabelStyle}" Text="{Binding Resources.EndTime}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="58" />
            </Grid.ColumnDefinitions>
            <Slider Grid.Column="0"
                    Style="{StaticResource CalendarEditorTimeSliderStyle}"
                    Value="{Binding EndMinuteOfDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{Binding Resources.EndTime}"
                    ToolTip="{Binding EndTime}" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource CalendarEditorTimeValueStyle}"
                       Text="{Binding EndTime}" />
          </Grid>

          <TextBlock Style="{StaticResource CalendarFieldLabelStyle}" Text="{Binding Resources.EventColor}" />
          <ComboBox Style="{StaticResource CalendarEditorComboBoxStyle}"
                    ItemsSource="{Binding ColorOptions}"
                    SelectedItem="{Binding SelectedColor, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="16" Height="16" CornerRadius="8"
                          Background="{Binding Brush}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Style="{StaticResource CalendarFieldLabelStyle}" Text="{Binding Resources.Reminder}" />
          <ComboBox Style="{StaticResource CalendarEditorComboBoxStyle}"
                    ItemsSource="{Binding ReminderOptions}"
                    DisplayMemberPath="Label"
                    SelectedItem="{Binding SelectedReminder, Mode=TwoWay}" />

          <CheckBox Margin="{StaticResource CalendarEditorFieldMargin}"
                    Style="{StaticResource CalendarEditorCheckBoxStyle}"
                    Content="{Binding Resources.EventEnabled}"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Margin="{StaticResource CalendarEditorFieldMargin}">
        <TextBlock Foreground="{StaticResource ErrorBrush}"
                   Text="{Binding EditorError}"
                   TextWrapping="Wrap" />
        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                   Text="{Binding Resources.ApplyingEventChanges}"
                   Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Button Style="{StaticResource CalendarPrimaryButtonStyle}"
                Content="{Binding Resources.SaveEvent}"
                Command="{Binding SaveEventCommand}" />

        <StackPanel Visibility="{Binding CanDeleteEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Button Style="{StaticResource CalendarDeleteButtonStyle}"
                  Content="{Binding Resources.DeleteEvent}"
                  Command="{Binding RequestDeleteCommand}"
                  Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
          <StackPanel Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="{StaticResource CalendarEditorFieldMargin}"
                       Text="{Binding Resources.ConfirmDeleteEvent}" />
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource CalendarDeleteButtonStyle}"
                      Content="{Binding Resources.DeleteEvent}"
                      Command="{Binding DeleteEventCommand}" />
              <Button Style="{StaticResource CalendarToolbarButtonStyle}"
                      Content="{Binding Resources.Cancel}"
                      Command="{Binding CancelDeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
