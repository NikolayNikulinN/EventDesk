<UserControl x:Class="EventDesk.Resources.Controls.Calendar.MiniCalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource CalendarSidePanelStyle}">
    <Calendar x:Name="MiniCalendar"
              Loaded="MiniCalendarLoaded"
              SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
              FirstDayOfWeek="Monday"
              CalendarDayButtonStyle="{StaticResource MiniCalendarDayButtonStyle}"
              CalendarButtonStyle="{StaticResource MiniCalendarMonthButtonStyle}"
              HorizontalAlignment="Center" />
  </Border>
</UserControl>
