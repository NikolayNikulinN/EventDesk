<UserControl x:Class="EventDesk.Resources.Controls.Calendar.EventCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calendar="clr-namespace:EventDesk.Resources.Controls.Calendar">
  <UserControl.Width>
    <MultiBinding Converter="{StaticResource CalendarDayScaleConverter}">
      <Binding Path="Width" />
      <Binding Path="DayWidth" RelativeSource="{RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}" />
    </MultiBinding>
  </UserControl.Width>
  <UserControl.Height>
    <MultiBinding Converter="{StaticResource CalendarEventHeightScaleConverter}">
      <Binding Path="Height" />
      <Binding Path="HourHeight" RelativeSource="{RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}" />
    </MultiBinding>
  </UserControl.Height>
  <Button Style="{StaticResource CalendarEventCardStyle}"
          BorderBrush="{Binding ColorBrush}"
          Background="{Binding FillBrush}"
          Command="{Binding DataContext.EditEventCommand, RelativeSource={RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}}"
          CommandParameter="{Binding}">
    <Button.ToolTip>
      <ToolTip Style="{StaticResource CalendarEventToolTipStyle}"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <StackPanel MaxWidth="320">
          <TextBlock Style="{StaticResource CalendarEventToolTipTitleStyle}"
                     Text="{Binding Title}" />
          <TextBlock Style="{StaticResource CalendarEventToolTipTimeStyle}"
                     Text="{Binding TimeRange}" />
          <Border Style="{StaticResource CalendarEventToolTipDividerStyle}" />
          <TextBlock Style="{StaticResource CalendarEventToolTipDescriptionStyle}"
                     Text="{Binding Source.Description}" />
        </StackPanel>
      </ToolTip>
    </Button.ToolTip>
    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
  </Button>
</UserControl>
