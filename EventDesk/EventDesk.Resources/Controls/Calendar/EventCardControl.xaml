<UserControl x:Class="EventDesk.Resources.Controls.Calendar.EventCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calendar="clr-namespace:EventDesk.Resources.Controls.Calendar">
  <UserControl.Width>
    <MultiBinding Converter="{StaticResource CalendarDayScaleConverter}">
      <Binding Path="Width" />
      <Binding Path="DayWidth" RelativeSource="{RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}" />
    </MultiBinding>
  </UserControl.Width>
  <UserControl.Height>
    <MultiBinding Converter="{StaticResource CalendarEventHeightScaleConverter}">
      <Binding Path="Height" />
      <Binding Path="HourHeight" RelativeSource="{RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}" />
    </MultiBinding>
  </UserControl.Height>
  <Button Style="{StaticResource CalendarEventCardStyle}"
          BorderBrush="{Binding ColorBrush}"
          Command="{Binding DataContext.EditEventCommand, RelativeSource={RelativeSource AncestorType={x:Type calendar:WeekCalendarControl}}}"
          CommandParameter="{Binding}"
          ToolTip="{Binding TimeRange}">
    <StackPanel>
      <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
      <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding TimeRange}" />
    </StackPanel>
  </Button>
</UserControl>
