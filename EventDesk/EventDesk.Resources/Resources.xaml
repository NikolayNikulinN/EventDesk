<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converters="clr-namespace:EventDesk.Resources.Converters"
                    xmlns:calendar="clr-namespace:EventDesk.Resources.Controls.Calendar">
  <ResourceDictionary.MergedDictionaries>
    <ui:ThemesDictionary Theme="Light" />
    <ui:ControlsDictionary />
    <ResourceDictionary Source="Theme/Colors.xaml" />
    <ResourceDictionary Source="Theme/Brushes.xaml" />
    <ResourceDictionary Source="Theme/Typography.xaml" />
    <ResourceDictionary Source="Theme/Spacing.xaml" />
    <ResourceDictionary Source="Theme/CornerRadius.xaml" />
    <ResourceDictionary Source="Styles/WindowStyles.xaml" />
    <ResourceDictionary Source="Styles/PageStyles.xaml" />
    <ResourceDictionary Source="Styles/CalendarStyles.xaml" />
    <ResourceDictionary Source="Styles/HistoryStyles.xaml" />
    <ResourceDictionary Source="Styles/SettingsStyles.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
  <converters:CalendarScaleConverter x:Key="CalendarHourScaleConverter"
                                      BaseSize="{x:Static calendar:CalendarLayout.HourHeight}" />
  <converters:CalendarScaleConverter x:Key="CalendarEventHeightScaleConverter"
                                      BaseSize="{x:Static calendar:CalendarLayout.HourHeight}"
                                      MinimumValue="{x:Static calendar:CalendarLayout.MinimumEventHeight}" />
  <converters:CalendarScaleConverter x:Key="CalendarDayScaleConverter"
                                      BaseSize="{x:Static calendar:CalendarLayout.DayWidth}" />
</ResourceDictionary>
