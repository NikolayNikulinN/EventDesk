<?xml version="1.0" encoding="utf-8"?>
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <Font Id="0" Height="-12" Weight="500" Foreground="342720">Segoe UI</Font>
  <Font Id="1" Height="-18" Weight="700" Foreground="ba5e42">Segoe UI</Font>
  <Font Id="2" Height="-31" Weight="700" Foreground="342720">Segoe UI</Font>
  <Font Id="3" Height="-14" Weight="400" Foreground="847166">Segoe UI</Font>
  <Font Id="4" Height="-16" Weight="600" Foreground="ffffff">Segoe UI</Font>
  <Font Id="5" Height="-25" Weight="700" Foreground="342720">Segoe UI</Font>
  <Font Id="6" Height="-12" Weight="500" Foreground="ffffff">Segoe UI</Font>

  <Window Width="620" Height="380" HexStyle="100a0000" FontId="0"
          Caption="#(loc.Caption)" IconFile="appTrayIcon.ico">
    <ImageControl X="0" Y="0" Width="620" Height="380"
                  ImageFile="installerBackground.png" Visible="yes" />
    <ImageControl X="410" Y="100" Width="168" Height="168"
                  ImageFile="logo.png" Visible="yes" />
    <Label X="42" Y="31" Width="280" Height="29" FontId="1"
           Visible="yes" DisablePrefix="yes">#(loc.Brand)</Label>
    <Label X="397" Y="294" Width="200" Height="24" FontId="6"
           Visible="yes" DisablePrefix="yes">#(loc.SideCaption)</Label>

    <Page Name="Loading">
      <Label X="42" Y="133" Width="300" Height="66" FontId="5"
             DisablePrefix="yes">#(loc.LoadingTitle)</Label>
    </Page>

    <Page Name="Install">
      <Label X="42" Y="112" Width="310" Height="80" FontId="2"
             DisablePrefix="yes">#(loc.WelcomeTitle)</Label>
      <Label X="42" Y="208" Width="294" Height="52" FontId="3"
             DisablePrefix="yes">#(loc.WelcomeBody)</Label>
      <Button Name="InstallButton" X="42" Y="286" Width="188" Height="48"
              TabStop="yes" FontId="4" HoverFontId="4" SelectedFontId="4">
        <ButtonImage ImageFile="installerButtonNormal.png" />
        <ButtonHoverImage ImageFile="installerButtonHover.png" />
        <ButtonSelectedImage ImageFile="installerButtonPressed.png" />
        <Text>#(loc.InstallButton)</Text>
      </Button>
    </Page>

    <Page Name="Progress">
      <Label X="42" Y="112" Width="310" Height="72" FontId="5"
             DisablePrefix="yes">#(loc.ProgressTitle)</Label>
      <Label X="42" Y="190" Width="300" Height="35" FontId="3"
             DisablePrefix="yes">#(loc.ProgressBody)</Label>
      <Label Name="OverallProgressPackageText" X="42" Y="240" Width="300"
             Height="24" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
      <Progressbar Name="OverallCalculatedProgressbar" X="42" Y="276"
                   Width="295" Height="14" />
    </Page>

    <Page Name="Modify">
      <Label X="42" Y="112" Width="310" Height="72" FontId="5"
             DisablePrefix="yes">#(loc.ModifyTitle)</Label>
      <Label X="42" Y="194" Width="300" Height="52" FontId="3"
             DisablePrefix="yes">#(loc.ModifyBody)</Label>
      <Button Name="UninstallButton" X="42" Y="286" Width="188" Height="48"
              TabStop="yes" FontId="4" HoverFontId="4" SelectedFontId="4">
        <ButtonImage ImageFile="installerButtonNormal.png" />
        <ButtonHoverImage ImageFile="installerButtonHover.png" />
        <ButtonSelectedImage ImageFile="installerButtonPressed.png" />
        <Text>#(loc.UninstallButton)</Text>
      </Button>
    </Page>

    <Page Name="Success">
      <Label X="42" Y="112" Width="310" Height="72" FontId="5"
             DisablePrefix="yes">
        <Text>#(loc.SuccessTitle)</Text>
        <Text Condition="WixBundleAction = 4">#(loc.UninstallSuccessTitle)</Text>
      </Label>
      <Label X="42" Y="194" Width="300" Height="52" FontId="3"
             DisablePrefix="yes">#(loc.SuccessBody)</Label>
      <Button Name="SuccessCloseButton" X="42" Y="286" Width="188" Height="48"
              TabStop="yes" FontId="4" HoverFontId="4" SelectedFontId="4">
        <ButtonImage ImageFile="installerButtonNormal.png" />
        <ButtonHoverImage ImageFile="installerButtonHover.png" />
        <ButtonSelectedImage ImageFile="installerButtonPressed.png" />
        <Text>#(loc.CloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Failure">
      <Label X="42" Y="105" Width="310" Height="62" FontId="5"
             DisablePrefix="yes">#(loc.FailureTitle)</Label>
      <Label X="42" Y="172" Width="300" Height="41" FontId="3"
             DisablePrefix="yes">#(loc.FailureBody)</Label>
      <Hypertext Name="FailureMessageText" X="42" Y="214" Width="302"
                 Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
      <Hypertext Name="FailureLogFileLink" X="42" Y="254" Width="302"
                 Height="28" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureLogLink)</Hypertext>
      <Button Name="FailureCloseButton" X="42" Y="300" Width="188" Height="48"
              TabStop="yes" FontId="4" HoverFontId="4" SelectedFontId="4">
        <ButtonImage ImageFile="installerButtonNormal.png" />
        <ButtonHoverImage ImageFile="installerButtonHover.png" />
        <ButtonSelectedImage ImageFile="installerButtonPressed.png" />
        <Text>#(loc.CloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Help">
      <Label X="42" Y="120" Width="300" Height="66" FontId="5"
             DisablePrefix="yes">#(loc.HelpTitle)</Label>
      <Button Name="HelpCloseButton" X="42" Y="286" Width="188" Height="48"
              TabStop="yes" FontId="4" HoverFontId="4" SelectedFontId="4">
        <ButtonImage ImageFile="installerButtonNormal.png" />
        <ButtonHoverImage ImageFile="installerButtonHover.png" />
        <ButtonSelectedImage ImageFile="installerButtonPressed.png" />
        <Text>#(loc.CloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>
  </Window>
</Theme>
